{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignorePatterns": [
    ".storybook/**",
    "**/mock-data/**",
    "**/mocks/**",
    "**/__mocks__/**",
    "**/*mock*.*",
    "**/generated/**",
    "**/*.generated.*",
    "**/*.gen.*",
    "src/client/**",
    "src/assets/themes/theme.css",
    "openapi-ts.config.ts",
    "transloco.config.ts"
  ],
  "ignoreFindings": ["src/app/shared/template-table-enter-fetch-method/template-table-enter-fetch.component.ts"],
  "ignoreDependencies": ["@angular-eslint/builder", "@angular-eslint/schematics", "@jsverse/transloco-utils"],
  "ignoreExports": [
    {
      "file": "eslint-transloco-plugin/rules/require-alt-transloco-t.js",
      "exports": ["*"]
    },
    {
      "file": "eslint-transloco-plugin/rules/require-transloco-t.js",
      "exports": ["*"]
    },
    {
      "file": "eslint-custom-rules/index.js",
      "exports": ["*"]
    },
    {
      "file": "eslint-transloco-plugin/index.js",
      "exports": ["*"]
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
