{
  "name": "angular-template-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration=local",
    "start:mock": "ng serve --configuration=mock",
    "build": "ng build",
    "prettier:write": "npx prettier --write \"src/**/*.{html,ts,scss}\"",
    "format:biome": "npx @biomejs/biome format --write ./src",
    "watch": "ng build --watch --configuration development",
    "run-unit-tests:terminal": "ng test --no-watch",
    "run-unit-tests:coverage": "ng test --no-watch --coverage",
    "run-unit-tests:coverage-browser": "ng test --no-watch --coverage && start coverage/Angular-Template-V2/index.html",
    "run-unit-tests:browser": "ng test --configuration=browser",
    "lint": "ng lint",
    "lint:biome": "npx @biomejs/biome lint ./src --write",
    "prepare": "husky",
    "eslint": "eslint",
    "openapi-ts": "npx @hey-api/openapi-ts",
    "migrate:standalone": "ng generate @angular/core:standalone",
    "migrate:control_flow": "ng generate @angular/core:control-flow",
    "migrate:signal_inputs": "ng generate @angular/core:signal-input-migration",
    "migrate:signal_outputs": "ng generate @angular/core:output-migration",
    "migrate:cleanup_imports": "ng generate @angular/core:cleanup-unused-imports",
    "migrate:self_closing_tags": "ng generate @angular/core:self-closing-tag",
    "migrate:common_module": "ng generate @angular/core:common-to-standalone",
    "migrate:inject": "ng generate @angular/core:inject",
    "migrate:route_lazy_loading": "ng generate @angular/core:route-lazy-loading",
    "migrate:signal_queries": "ng generate @angular/core:signal-queries-migration",
    "migrate:ngclass_to_class": "ng generate @angular/core:ngclass-to-class",
    "migrate:ngstyle_to_style": "ng generate @angular/core:ngstyle-to-style",
    "migrate:router_testing_module": "ng generate @angular/core:router-testing-module-migration",
    "migrate:all": "npm run migrate:standalone && npm run migrate:control_flow && npm run migrate:signal_inputs && npm run migrate:signal_outputs && npm run migrate:signal_queries && npm run migrate:inject && npm run migrate:route_lazy_loading && npm run migrate:ngclass_to_class && npm run migrate:ngstyle_to_style && npm run migrate:self_closing_tags && npm run migrate:common_module && npm run migrate:router_testing_module && npm run migrate:cleanup_imports"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/google-maps": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/material-experimental": "^22.1.0",
    "@angular/material-luxon-adapter": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@biomejs/biome": "^2.5.6",
    "@ng-web-apis/common": "^5.3.0",
    "@ngrx/operators": "^21.1.1",
    "luxon": "^3.7.2",
    "npm-check-updates": "^23.0.0",
    "prettier": "^3.9.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@jsverse/transloco": "^8.4.0",
    "@types/jasmine": "~6.0.0",
    "@types/luxon": "^3.7.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
