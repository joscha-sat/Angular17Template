{
  "name": "angular-template-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration=local",
    "build": "ng build",
    "prettier:write": "npx prettier --write \"src/**/*.{html,ts,scss}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "prepare": "husky",
    "eslint": "eslint",
    "migrate:standalone": "ng generate @angular/core:standalone",
    "migrate:control_flow": "ng generate @angular/core:control-flow",
    "migrate:signal_inputs": "ng generate @angular/core:signal-input-migration",
    "migrate:signal_outputs": "ng generate @angular/core:output-migration",
    "migrate:cleanup_imports": "ng generate @angular/core:cleanup-unused-imports",
    "migrate:self_closing_tags": "ng generate @angular/core:self-closing-tag",
    "migrate:common_module": "ng generate @angular/core:common-to-standalone",
    "migrate:inject": "ng generate @angular/core:inject",
    "migrate:route_lazy_loading": "ng generate @angular/core:route-lazy-loading",
    "migrate:signal_queries": "ng generate @angular/core:signal-queries-migration",
    "migrate:ngclass_to_class": "ng generate @angular/core:ngclass-to-class",
    "migrate:ngstyle_to_style": "ng generate @angular/core:ngstyle-to-style",
    "migrate:router_testing_module": "ng generate @angular/core:router-testing-module-migration",
    "migrate:all": "npm run migrate:standalone && npm run migrate:control_flow && npm run migrate:signal_inputs && npm run migrate:signal_outputs && npm run migrate:signal_queries && npm run migrate:inject && npm run migrate:route_lazy_loading && npm run migrate:ngclass_to_class && npm run migrate:ngstyle_to_style && npm run migrate:self_closing_tags && npm run migrate:common_module && npm run migrate:router_testing_module && npm run migrate:cleanup_imports"
  },
  "private": true,
  "dependencies": {
    "@angular-eslint/schematics": "^21.3.1",
    "@angular/animations": "^21.2.6",
    "@angular/cdk": "^21.2.4",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/google-maps": "^21.2.4",
    "@angular/localize": "^21.2.6",
    "@angular/material": "^21.2.4",
    "@angular/material-experimental": "^21.2.4",
    "@angular/material-luxon-adapter": "^21.2.4",
    "@angular/platform-browser": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@ng-web-apis/common": "^5.2.0",
    "@ngrx/operators": "^21.1.0",
    "luxon": "^3.7.2",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.5",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco": "^8.2.1",
    "@types/jasmine": "~6.0.0",
    "@types/luxon": "^3.7.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@typescript-eslint/utils": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-plugin-rxjs-x": "^1.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
